# connect-src is set to the guardscope-dev project. Production deploys must substitute their own project host (ARCHITECTURE.md §5.2).
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://eqozjuaaajstrewygqxr.supabase.co; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

/p
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/p/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
